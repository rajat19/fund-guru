# Pin the registry to public npm.
#
# Committed deliberately: this file overrides any user- or machine-level
# ~/.npmrc, so the project resolves the same packages whether it is built on a
# laptop behind a corporate proxy, in CI, or on a fresh clone. Without it, a
# corporate registry mirror inherited from ~/.npmrc can serve different (or
# stale, or internally-patched) versions than the lockfile was resolved against,
# which produces "works on my machine" installs.
registry=https://registry.npmjs.org/

# Scoped packages resolve to the same place. Listed explicitly because a scope
# mapping in ~/.npmrc is NOT overridden by a bare `registry=` line here — the
# more specific key wins, so it has to be restated.
@types:registry=https://registry.npmjs.org/
@radix-ui:registry=https://registry.npmjs.org/
@tanstack:registry=https://registry.npmjs.org/
@vitejs:registry=https://registry.npmjs.org/
@vitest:registry=https://registry.npmjs.org/
@hookform:registry=https://registry.npmjs.org/
@eslint:registry=https://registry.npmjs.org/
@swc:registry=https://registry.npmjs.org/
@tailwindcss:registry=https://registry.npmjs.org/

# Fail loudly rather than silently resolving something the lockfile does not
# describe. Keeps local installs honest with CI, which uses --frozen-lockfile.
resolution-mode=highest
