rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Mutual funds data — public read, admin-only write (or specific email)
    match /mutual_funds/{fundId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.admin == true || request.auth.token.email == 'rajatsri94@gmail.com');
    }
    
    // Sync metadata — public read, admin-only write (or specific email)
    match /metadata/{docId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.admin == true || request.auth.token.email == 'rajatsri94@gmail.com');
    }
    
    // User profiles — users can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
