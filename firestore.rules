rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin check. The email allowlist is the bootstrap path (the first admin
    // has no user document yet); the isAdmin flag covers everyone after that.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'rajatsri94@gmail.com' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        )
      );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Fund data.
    //
    // Reads require sign-in. Anonymous visitors are served the published static
    // dataset (public/data/funds.json) instead, which costs nothing; this
    // collection is only the fallback. Leaving it world-readable let anyone
    // enumerate ~3,000 documents and drain the daily read quota, since a full
    // collection scan bills one read per document.
    match /mutual_funds/{fundId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Single documents, cheap to read, needed before sign-in.
    match /metadata/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles — strict, to prevent privilege escalation.
    match /users/{userId} {
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();

      // A user may create their own profile but cannot self-grant admin.
      allow create: if (isSignedIn() && request.auth.uid == userId
                        && request.resource.data.isAdmin == false) || isAdmin();

      // A user may update their own profile but cannot change isAdmin.
      allow update: if (isSignedIn() && request.auth.uid == userId
                        && request.resource.data.isAdmin == resource.data.isAdmin) || isAdmin();

      allow delete: if isAdmin();
    }

    // Per-user private data (SIPs, goals, holdings). Owner-only, no admin
    // read — there is no reason for an admin to see someone's portfolio.
    match /users/{userId}/{collection}/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
